<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>ai.pivot360.agents</groupId>
    <artifactId>agent-runtime</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Agent Runtime</name>
    <description>General-purpose multi-agent orchestration platform runtime</description>

    <modules>
        <module>agent-runtime-common</module>
        <module>agent-runtime-persistence</module>
        <module>agent-runtime-llm</module>
        <module>agent-runtime-mcp</module>
        <module>agent-runtime-temporal</module>
        <module>agent-runtime-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <spring-ai.version>2.0.1</spring-ai.version>
        <temporal.version>1.37.0</temporal.version>
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.temporal</groupId>
                <artifactId>temporal-spring-boot-starter</artifactId>
                <version>${temporal.version}</version>
            </dependency>
            <dependency>
                <groupId>io.temporal</groupId>
                <artifactId>temporal-testing</artifactId>
                <version>${temporal.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- internal modules -->
            <dependency>
                <groupId>ai.pivot360.agents</groupId>
                <artifactId>agent-runtime-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.pivot360.agents</groupId>
                <artifactId>agent-runtime-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.pivot360.agents</groupId>
                <artifactId>agent-runtime-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.pivot360.agents</groupId>
                <artifactId>agent-runtime-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.pivot360.agents</groupId>
                <artifactId>agent-runtime-temporal</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
